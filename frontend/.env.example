# URL base del backend (NestJS). En desarrollo local corre en el puerto 3001.
# Esta rama (features-local) está pensada solo para ejecución local: el default
# activo es localhost. La URL de producción (Render) queda comentada a modo de
# referencia — la configuración de deploy real vive en otra rama (features/main).
NEXT_PUBLIC_API_URL=http://localhost:3001
#NEXT_PUBLIC_API_URL=https://evangelicapp-backend.onrender.com