# URL base del backend (NestJS). En desarrollo local corre en el puerto 3001.
#NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=https://evangelicapp-backend.onrender.com

# Supabase Realtime — SOLO para el canal de tiempo real de las 3 pantallas
# "en vivo" (dashboard SuperAdmin, detalle de evento, censo QR). Ver
# src/hooks/use-realtime.ts y frontend/prompt.md. NO se usa supabase-js para
# datos/auth/storage: eso sigue yendo por apiFetch contra el backend.
# Son del proyecto Supabase "Backend" (el de la BD). La anon key NO es secreta
# (es publishable); sacala del dashboard (proyecto "Backend" > Project Settings
# > API > anon/public) o pedila al equipo. Si faltan, el frontend arranca en
# modo "sin realtime" (las pantallas siguen con su carga/refresh REST normal).
NEXT_PUBLIC_SUPABASE_URL=https://lkcgiqmgdefhxhckedga.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL de la política de privacidad (Ley 21.719) que se linkea en el checkbox
# de consentimiento del formulario público de registro de integrantes. Si no
# se define, cae a la ruta relativa /politica-privacidad (todavía no existe).
#NEXT_PUBLIC_URL_POLITICA_PRIVACIDAD=/politica-privacidad

# Solo para el deploy de staging a Cloudflare Workers (ver wrangler.jsonc):
# desactiva la optimización on-the-fly de next/image, que en Cloudflare
# requiere Cloudflare Images o un loader custom (no "gratis" como en Vercel).
# No setear en Vercel/local -- ahí next/image debe seguir optimizando.
#NEXT_IMAGES_UNOPTIMIZED=true