{
	// Config de despliegue a Cloudflare Workers vía @opennextjs/cloudflare.
	// Target de STAGING/QA — no reemplaza el deploy de producción en Vercel
	// (ver frontend/FEATURES.md, entrada de esta fecha, para el detalle).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "evangelicapp-frontend-staging",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-25",
	// nodejs_compat: requerido por @opennextjs/cloudflare (usa APIs de Node
	// internamente). global_fetch_strictly_public: flag recomendado por el
	// mismo adapter para el ejemplo oficial (create-next-app) al día de hoy.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	}
}
