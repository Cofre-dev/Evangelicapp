{
	// Config de despliegue a Cloudflare Workers vía @opennextjs/cloudflare.
	// Cloudflare Workers es el hosting elegido para producción (no Vercel) —
	// plan completo en frontend/docs/deploy-produccion.md.
	//
	// El name tiene que coincidir con el Worker que Workers Builds construye
	// (hoy "evangelicapp", que sirve la rama `staging` en
	// evangelicapp.rojascofrem.workers.dev). Si no coinciden, `wrangler deploy`
	// tira "Failed to match Worker name" e intenta abrir un PR para "corregirlo".
	//
	// Custom domain (app.evangelicapp.cl) y separación staging/producción: NO se
	// configuran acá todavía. Agregar `routes`/`custom_domain` antes de que la
	// zona evangelicapp.cl esté en la cuenta de Cloudflare hace fallar el deploy.
	// Se hace desde el dashboard una vez que el DNS está delegado (checklist §5).
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "evangelicapp",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-25",
	// nodejs_compat: requerido por @opennextjs/cloudflare (usa APIs de Node
	// internamente). global_fetch_strictly_public: flag recomendado por el
	// mismo adapter para el ejemplo oficial (create-next-app) al día de hoy.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	}
}
